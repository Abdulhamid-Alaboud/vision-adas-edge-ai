        <mxCell id="08_relational_schema_31" value="Data Isolation &amp; Calibration Guarantees:&#10;1. Guest sessions operate strictly with tripId = 0; DatabaseHelper skips SQLite inserts and CloudSync.&#10;2. Foreign Key integrity enforced via ON DELETE CASCADE between TRIP and DETECTION_RECORD.&#10;3. PreferencesManager stores language (AR/EN), alert volume, global threshold &amp; enabled hazard classes." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#EDF3F9;strokeColor=#1B365D;strokeWidth=2;fontColor=#0F172A;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=6;fontFamily=Segoe UI;" parent="1" vertex="1">
