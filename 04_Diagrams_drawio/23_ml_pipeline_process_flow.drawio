  <diagram id="23_ml_pipeline_process_flow" name="Process Flow Diagram - End-to-End Machine Learni">
    <mxGraphModel dx="1420" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="620" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="23_ml_pipeline_process_flow_2" value="Process Flow Diagram - End-to-End Machine Learning &amp; Mobile Deployment Pipeline" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1B365D;strokeColor=#1B365D;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=left;spacingLeft=18;fontFamily=Segoe UI;" parent="1" vertex="1">
          <mxGeometry x="16" y="12" width="1248" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="23_ml_pipeline_process_flow_3" value="PHASE A: Data Engineering &amp; Multi-Architecture Model Training (Google Colab T4 GPU)" style="swimlane;whiteSpace=wrap;html=0;startSize=30;rounded=1;arcSize=8;fillColor=#1B365D;swimlaneFillColor=#F4F7FA;strokeColor=#1B365D;strokeWidth=2;fontColor=#FFFFFF;fontSize=11.5;fontStyle=1;collapsible=0;fontFamily=Segoe UI;" parent="1" vertex="1">
          <mxGeometry x="22" y="68" width="1236" height="232" as="geometry"/>
        </mxCell>
        <mxCell id="23_ml_pipeline_process_flow_4" value="1. Road Data Acquisition&#10;&#10;• Multi-source Arabic roadways&#10;• Real dashcam &amp; urban imagery&#10;• Public road sign benchmarks&#10;• Total Curated: 8,842 images&#10;• Includes 1,586 hard negatives" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#1B365D;strokeWidth=2;fontColor=#0F172A;fontSize=10.5;fontStyle=1;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;" parent="1" vertex="1">
          <mxGeometry x="42" y="120" width="265" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="23_ml_pipeline_process_flow_5" value="2. Annotation &amp; Strict Split&#10;&#10;• Manual Roboflow BBox labeling&#10;• 12,203 verified objects (14 classes)&#10;• Leakage-free stratified split:&#10;  - Train: 70% (6,191 imgs / 8,520)&#10;  - Valid: 20% (1,767 imgs / 2,405)&#10;  - Test:  10% (884 imgs / 1,278)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#EDF3F9;strokeColor=#335C81;strokeWidth=2;fontColor=#0F172A;fontSize=10.4;fontStyle=1;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;" parent="1" vertex="1">
          <mxGeometry x="348" y="120" width="265" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="23_ml_pipeline_process_flow_6" value="3. Pre-Processing &amp; Augmentation&#10;&#10;• Resize/letterbox to 640 x 640 RGB&#10;• 3x Night Speed-Bump low-gamma&#10;• Selective sign retro-reflection&#10;• Zero horizontal flip (preserves&#10;  directional semantics &amp; text)&#10;• Zero distortion on Val/Test splits" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#E8EEF5;strokeColor=#2B5B84;strokeWidth=2;fontColor=#0F172A;fontSize=10.4;fontStyle=1;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;" parent="1" vertex="1">
          <mxGeometry x="654" y="120" width="275" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="23_ml_pipeline_process_flow_7" value="4. Multi-Model Training (T4 GPU)&#10;&#10;• YOLOv11n-ADAS-v2 (150 ep, SGD)&#10;• YOLOv26n (100 epochs)&#10;• D-FINE-N (HGNetV2-B0, 35 ep)&#10;• RT-DETRv2-S (ResNet-18, 25 ep)&#10;• Track loss, P, R, mAP@50" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#EEF1F7;strokeColor=#3B4D75;strokeWidth=2;fontColor=#0F172A;fontSize=10.4;fontStyle=1;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;" parent="1" vertex="1">
          <mxGeometry x="970" y="120" width="268" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="23_ml_pipeline_process_flow_8" value="Raw BBoxes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#1B365D;strokeWidth=1.9;startArrow=none;endArrow=classic;fontSize=10.5;fontColor=#0F172A;fontStyle=1;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="307" y="194" as="sourcePoint"/>
            <mxPoint x="348" y="194" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="23_ml_pipeline_process_flow_9" value="Train/Val/Test" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#335C81;strokeWidth=1.9;startArrow=none;endArrow=classic;fontSize=10.5;fontColor=#0F172A;fontStyle=1;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
