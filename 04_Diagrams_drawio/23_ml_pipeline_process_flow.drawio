            <mxPoint x="970" y="194" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="23_ml_pipeline_process_flow_11" value="PHASE B: Held-Out Evaluation, Model Export &amp; Offline Android Integration (No Server Inference)" style="swimlane;whiteSpace=wrap;html=0;startSize=30;rounded=1;arcSize=8;fillColor=#2B5B84;swimlaneFillColor=#F4F6F9;strokeColor=#2B5B84;strokeWidth=2;fontColor=#FFFFFF;fontSize=11.5;fontStyle=1;collapsible=0;fontFamily=Segoe UI;" parent="1" vertex="1">
          <mxGeometry x="22" y="326" width="1236" height="268" as="geometry"/>
        </mxCell>
        <mxCell id="23_ml_pipeline_process_flow_12" value="5. Held-Out Unseen Evaluation&#10;&#10;• Test Split n=884 unseen images&#10;• YOLOv11n: 95.82% mAP@50,&#10;  97.17% P, 93.05% R, 83.95% 50-95&#10;• Confusion matrix &amp; PR curve&#10;• Selected for accuracy/CPU Pareto" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#3B4D75;strokeWidth=2;fontColor=#0F172A;fontSize=10.4;fontStyle=1;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;" parent="1" vertex="1">
          <mxGeometry x="970" y="376" width="268" height="144" as="geometry"/>
        </mxCell>
        <mxCell id="23_ml_pipeline_process_flow_13" value="6. ONNX Export &amp; CPU Profiling&#10;&#10;• Export best.pt -&gt; FP32 ONNX&#10;• Model: yolo11n_adas_v2_640.onnx&#10;• Compact footprint: 10.12 MiB&#10;• x86 ONNX mean: 34.58 ms vs&#10;  D-FINE-N 373.82 ms (10.8x faster)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#EDF3F9;strokeColor=#335C81;strokeWidth=2;fontColor=#0F172A;fontSize=10.4;fontStyle=1;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;" parent="1" vertex="1">
          <mxGeometry x="654" y="376" width="275" height="144" as="geometry"/>
        </mxCell>
        <mxCell id="23_ml_pipeline_process_flow_14" value="7. On-Device Edge Integration&#10;&#10;• Bundled in D:\vision assets/&#10;• ORT 1.18 (Multi-Thread CPU)&#10;• AdasSignVerifier Bayesian fusion&#10;• ML Kit OCR (+6 speed limits)&#10;• SoundPool 40 MP3s + GPS/Export" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#EEF5F2;strokeColor=#2C5E50;strokeWidth=2;fontColor=#0F172A;fontSize=10.4;fontStyle=1;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;" parent="1" vertex="1">
          <mxGeometry x="348" y="376" width="265" height="144" as="geometry"/>
        </mxCell>
        <mxCell id="23_ml_pipeline_process_flow_15" value="8. Field Validation &amp; Feedback&#10;&#10;• Multi-sign AR/EN road trials&#10;  (80, Speed Bump, Stop, Ped)&#10;• 12/12 Gradle JVM Unit Tests&#10;• Unseen failure review feeds&#10;  hard-negative &amp; night curation" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontColor=#0F172A;fontSize=10.4;fontStyle=1;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;" parent="1" vertex="1">
          <mxGeometry x="42" y="376" width="265" height="144" as="geometry"/>
        </mxCell>
