        <mxCell id="23_ml_pipeline_process_flow_21" value="Process Flow Guarantee: All training and testing remain isolated (zero test leakage); inference runs 100% locally on Android with zero cloud dependency." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#1B365D;strokeWidth=2;fontColor=#0F172A;fontSize=10.5;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Segoe UI;" parent="1" vertex="1">
